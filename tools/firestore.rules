rules_version = '2';

// STOCHOS team database rules.
// Paste into Firebase console > Firestore Database > Rules > Publish.
// Replace OWNER_EMAIL_HERE with the maintainer's Google email (lowercase) before publishing.
// Why it works this way:
//  - members/{slug}: the public profile. Anyone can read it. Each person creates and changes their own
//    profile (name, role, bio, about, skills, links, photo). The maintainer can also edit any profile and add or remove people.
//  - allowed/{email}: which Google account belongs to which profile. Private. Only the maintainer writes it.
//  - meta/admin: has no data. It exists only so the sign-in page can ask "am I the maintainer?".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && myEmail() == 'OWNER_EMAIL_HERE';
    }
    function mySlug() {
      return get(/databases/$(database)/documents/allowed/$(myEmail())).data.slug;
    }
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }
    function linkOk(v, pattern) {
      return v is string && (v == '' || (v.size() <= 200 && v.matches(pattern)));
    }
    function optText(d, k, max) {
      return !(k in d) || shortText(d[k], max);
    }
    function photoOk(d) {
      return !('photo' in d) || d.photo == '' || (
        d.photo is string && d.photo.size() <= 200000
        && d.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')
      );
    }
    function memberOk(d) {
      return d.keys().hasOnly(['name', 'role', 'bio', 'about', 'skills', 'linkedin', 'github', 'website', 'photo'])
        && d.keys().hasAll(['name', 'role', 'linkedin', 'github'])
        && shortText(d.name, 80) && d.name.size() > 0
        && shortText(d.role, 200)
        && optText(d, 'bio', 300)
        && optText(d, 'about', 3000)
        && optText(d, 'skills', 300)
        && linkOk(d.linkedin, '^https://([a-z0-9-]+\\.)?linkedin\\.com/.+$')
        && linkOk(d.github, '^https://(www\\.)?github\\.com/.+$')
        && (!('website' in d) || linkOk(d.website, '^https://[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(/[^\\s]*)?$'))
        && photoOk(d);
    }

    match /members/{slug} {
      allow read: if true;
      allow create: if memberOk(request.resource.data) && (
        isAdmin() || (signedIn() && mySlug() == slug)
      );
      allow update: if memberOk(request.resource.data) && (
        isAdmin() || (signedIn() && mySlug() == slug)
      );
      allow delete: if isAdmin();
    }

    match /allowed/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow write: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if docId == 'admin' && isAdmin();
    }
  }
}
